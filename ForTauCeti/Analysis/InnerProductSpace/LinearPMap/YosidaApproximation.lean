/-!
# The Yosida approximation of a self-adjoint operator

The bounded flows used to build the unitary group generated by a self-adjoint
operator (Stone's theorem). The symmetric Yosida approximants and their
compact-time Cauchy convergence use Tau Ceti's signed-real-shift API. The bounded
approximating groups use `StronglyContinuousGroup.ofBoundedExp` directly,
including its group law, continuity, complex linearity and unitarity.

## Provenance

* **Original repository:** Spectra, commit `8dbaaf6728d1342ae16acf79fd7eef7c59b37e63`.
* **Original modules:** `Spectra/YosidaHille/Approximation/Helpers.lean` (the
  arithmetic of `I * n`) and `Spectra/YosidaHille/Approximation/Defs.lean`
  (`resolventAtIn`, `resolventAtNegIn`, `yosidaApproximant`, `yosidaApproximantSym`).
* **Original authors / copyright / licence:** Copyright (c) 2026 Spectra
  Formalization Project; `Authors: Adam Bornemann`; Apache 2.0.
* **Extraction class:** *adapted.*  The definitions are Spectra's; the arithmetic
  lemmas are transcribed; the hypothesis interface is changed — see below.
* **Semantic difference from the donor — one hypothesis instead of three.**
  Spectra threads `(hsym, hplus, hminus)` — formal self-adjointness plus `±i`
  deficiency-surjectivity — through every one of these definitions, because its
  resolvent is constructed from exactly those three inputs.  Here they collapse
  to a single `IsSelfAdjoint A`, because
  Tau Ceti's canonical `LinearPMap` resolvent supplies every nonreal resolvent
  point directly. These approximants now use that accepted resolver rather than
  the donor copy. That also removes the dependency on Spectra's
  `Resolvent/Range.lean` entirely.
-/

public section

open _root_.LinearPMap (
  resolvent)

namespace TauCeti
namespace LinearPMap

open Semigroups.StronglyContinuousGroup (ofBoundedExp)

open Complex Filter
open scoped InnerProductSpace Topology

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-! ### Arithmetic of `I * n` for `n : ℕ+` -/

/-- `I * n` lies off the real axis, so the resolvent is defined there. -/
theorem I_mul_pnat_im_ne_zero (n : ℕ+) : (I * (n : ℂ)).im ≠ 0 := by
  simp only [mul_im, I_re, I_im, zero_mul, one_mul, zero_add]
  exact Nat.cast_ne_zero.mpr n.ne_zero

/-- `-I * n` lies off the real axis. -/
theorem neg_I_mul_pnat_im_ne_zero (n : ℕ+) : (-I * (n : ℂ)).im ≠ 0 := by
  simp only [neg_mul, neg_im]
  exact neg_ne_zero.mpr (I_mul_pnat_im_ne_zero n)

variable {A : H →ₗ.[ℂ] H}

/-- Specialize the signed-real-shift convergence to the positive integer
sequence used in the definition of the limit flow. -/
private theorem uniformCauchySeqOn_yosidaFlow (hA : IsSelfAdjoint A) (ψ : H)
    {S : Set ℝ} {R : ℝ} (hS : ∀ t ∈ S, |t| ≤ R) :
    UniformCauchySeqOn
      (fun (n : ℕ+) (t : ℝ) => ofBoundedExp (A.symmetricYosidaApproximation (n : ℝ)) t ψ)
      atTop S := by
  have h := hA.uniformCauchySeqOn_exp_smul_I_smul_symmetricYosidaApproximation_apply ψ hS
  have hcast : Tendsto (fun n : ℕ+ => (n : ℝ)) atTop (cocompact ℝ) :=
    (tendsto_natCast_atTop_atTop.comp tendsto_PNat_val_atTop_atTop).mono_right atTop_le_cocompact
  have hc : UniformCauchySeqOn (fun (n : ℕ+) (t : ℝ) =>
      NormedSpace.exp ((t : ℂ) • (I • A.symmetricYosidaApproximation (n : ℝ))) ψ) atTop S :=
    fun u hu => (hcast.prodMap hcast).eventually (h u hu)
  simpa only [Semigroups.StronglyContinuousGroup.ofBoundedExp_apply,
    ContinuousLinearMap.coe_restrictScalars'] using hc

/-! ### The limit flow `exp(itA)` -/

/-- The strong limit of the approximating flows, pointwise. -/
noncomputable def expLimitFun (_hA : IsSelfAdjoint A) (t : ℝ) (ψ : H) : H :=
  limUnder atTop (fun n : ℕ+ => ofBoundedExp (A.symmetricYosidaApproximation (n : ℝ)) t ψ)

/-- The approximating flows converge to `expLimitFun`.  This is the defining property: the limit is
defined as `limUnder`, which only names a value, so every fact about it is proved by transporting a
fact about the approximants along this convergence. -/
theorem tendsto_expLimitFun (hA : IsSelfAdjoint A) (t : ℝ) (ψ : H) :
    Tendsto (fun n : ℕ+ => ofBoundedExp (A.symmetricYosidaApproximation (n : ℝ)) t ψ) atTop (𝓝
      (expLimitFun hA t ψ)) := by
  have h := uniformCauchySeqOn_yosidaFlow hA ψ (S := {s : ℝ | |s| ≤ |t|}) (fun _ hs => hs)
  have ht : t ∈ {s : ℝ | |s| ≤ |t|} := by
    change |t| ≤ |t|
    exact le_rfl
  exact (h.cauchySeq ht).tendsto_limUnder

/-- The limit flow is additive, by uniqueness of limits applied to the additive approximants. -/
theorem expLimitFun_add (hA : IsSelfAdjoint A) (t : ℝ) (x y : H) :
    expLimitFun hA t (x + y) = expLimitFun hA t x + expLimitFun hA t y := by
  refine tendsto_nhds_unique (tendsto_expLimitFun hA t (x + y)) ?_
  simpa only [map_add] using
    (tendsto_expLimitFun hA t x).add (tendsto_expLimitFun hA t y)

/-- The limit flow is complex-homogeneous. -/
theorem expLimitFun_smul (hA : IsSelfAdjoint A) (t : ℝ) (c : ℂ) (x : H) :
    expLimitFun hA t (c • x) = c • expLimitFun hA t x := by
  refine tendsto_nhds_unique (tendsto_expLimitFun hA t (c • x)) ?_
  have hunit := fun n : ℕ+ => Semigroups.StronglyContinuousGroup.isUnitary_ofBoundedExp _
    (hA.isSelfAdjoint_symmetricYosidaApproximation (n : ℝ))
  simpa only [(hunit _).map_smul] using (tendsto_expLimitFun hA t x).const_smul c

/-- The limit flow is norm-preserving: the approximants all are, and the norm passes to the
limit. -/
theorem norm_expLimitFun (hA : IsSelfAdjoint A) (t : ℝ) (ψ : H) :
    ‖expLimitFun hA t ψ‖ = ‖ψ‖ := by
  refine tendsto_nhds_unique ((tendsto_expLimitFun hA t ψ).norm) ?_
  simpa only [(Semigroups.StronglyContinuousGroup.isUnitary_ofBoundedExp _
      (hA.isSelfAdjoint_symmetricYosidaApproximation _)).norm_map] using tendsto_const_nhds

/-- The limit flow `exp(itA)` as a bounded operator. -/
@[expose]
noncomputable def expLimit (hA : IsSelfAdjoint A) (t : ℝ) : H →L[ℂ] H :=
  LinearMap.mkContinuous
    { toFun := expLimitFun hA t
      map_add' := expLimitFun_add hA t
      map_smul' := fun c x => by simpa using expLimitFun_smul hA t c x }
    1
    (fun ψ => by simp [norm_expLimitFun])

/-- The bundled limit flow acts as `expLimitFun`. -/
@[simp] theorem expLimit_apply (hA : IsSelfAdjoint A) (t : ℝ) (ψ : H) :
    expLimit hA t ψ = expLimitFun hA t ψ := (rfl)
/-- Norm preservation, restated for the bundled operator `expLimit`. -/
@[simp]
theorem norm_expLimit_apply (hA : IsSelfAdjoint A) (t : ℝ) (ψ : H) :
    ‖expLimit hA t ψ‖ = ‖ψ‖ := norm_expLimitFun hA t ψ

/-! ### The limit flow is a one-parameter unitary group -/

/-- The limit flow is the identity at time zero. -/
@[simp] theorem expLimit_zero (hA : IsSelfAdjoint A) : expLimit hA 0 = 1 := by
  ext ψ
  refine tendsto_nhds_unique (tendsto_expLimitFun hA 0 ψ) ?_
  simp

/-- The limit flow preserves inner products.  With `norm_expLimit_apply` and the group law this
is what makes `expLimit` unitary rather than merely isometric. -/
theorem inner_expLimit (hA : IsSelfAdjoint A) (t : ℝ) (ψ φ : H) :
    ⟪expLimit hA t ψ, expLimit hA t φ⟫_ℂ = ⟪ψ, φ⟫_ℂ := by
  refine tendsto_nhds_unique
    (((tendsto_expLimitFun hA t ψ).inner (tendsto_expLimitFun hA t φ))) ?_
  simpa only [(Semigroups.StronglyContinuousGroup.isUnitary_ofBoundedExp _
      (hA.isSelfAdjoint_symmetricYosidaApproximation _)).inner_map_map] using tendsto_const_nhds

/-- The group law `exp(i(s+t)A) = exp(isA) ∘ exp(itA)`.  Proved by splitting the approximation
error in two, since the approximants satisfy it only in the limit. -/
theorem expLimit_add (hA : IsSelfAdjoint A) (s t : ℝ) :
    expLimit hA (s + t) = (expLimit hA s).comp (expLimit hA t) := by
  let V (n : ℕ+) := ofBoundedExp (A.symmetricYosidaApproximation (n : ℝ))
  ext ψ
  refine tendsto_nhds_unique (tendsto_expLimitFun hA (s + t) ψ) ?_
  -- Split the error in the composition of two native bounded flows.
  have hstep : Tendsto (fun n : ℕ+ => V n s
    (V n t ψ)) atTop
      (𝓝 (expLimit hA s (expLimit hA t ψ))) := by
    rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨N₁, hN₁⟩ := (Metric.tendsto_atTop.mp (tendsto_expLimitFun hA t ψ)) (ε / 2)
      (by linarith)
    obtain ⟨N₂, hN₂⟩ := (Metric.tendsto_atTop.mp
      (tendsto_expLimitFun hA s (expLimit hA t ψ))) (ε / 2) (by linarith)
    refine ⟨max N₁ N₂, fun n hn => ?_⟩
    have h1 : dist (V n s (V n t ψ))
        (V n s (expLimit hA t ψ)) < ε / 2 := by
      rw [dist_eq_norm, ← ContinuousLinearMap.map_sub,
        (Semigroups.StronglyContinuousGroup.isUnitary_ofBoundedExp _
      (hA.isSelfAdjoint_symmetricYosidaApproximation _)).norm_map, ← dist_eq_norm]
      exact hN₁ n (le_trans (le_max_left _ _) hn)
    have h2 : dist (V n s (expLimit hA t ψ))
        (expLimit hA s (expLimit hA t ψ)) < ε / 2 :=
      hN₂ n (le_trans (le_max_right _ _) hn)
    calc dist (V n s (V n t ψ)) (expLimit hA s (expLimit hA t ψ))
        ≤ dist (V n s (V n t ψ))
            (V n s (expLimit hA t ψ))
          + dist (V n s (expLimit hA t ψ))
            (expLimit hA s (expLimit hA t ψ)) := dist_triangle _ _ _
      _ < ε / 2 + ε / 2 := add_lt_add h1 h2
      _ = ε := by ring
  refine hstep.congr fun n => ?_
  exact (Semigroups.StronglyContinuousGroup.map_add_apply _ s t ψ).symm

/-! ### Strong continuity -/

/-- Duhamel against the zero generator: `‖exp(iτAₙˢʸᵐ)ψ - ψ‖ ≤ |τ| ‖Aₙˢʸᵐψ‖`. -/
theorem norm_yosidaFlow_sub_self_le (hA : IsSelfAdjoint A) (n : ℕ+) (τ : ℝ) (ψ : H) :
    ‖ofBoundedExp (A.symmetricYosidaApproximation (n : ℝ)) τ ψ - ψ‖ ≤ |τ| *
      ‖A.symmetricYosidaApproximation (n : ℝ) ψ‖ := by
  have hzero : expTime ((I : ℂ) • (0 : H →L[ℂ] H)) τ = 1 := by
    simp [expTime_def]
  have h := norm_expTime_sub_expTime_le (hA.isSelfAdjoint_symmetricYosidaApproximation (n : ℝ))
    (IsSelfAdjoint.zero (H →L[ℂ] H)) (Commute.zero_right _) τ ψ
  rw [hzero] at h
  simp only [one_apply_eq_self, smul_zero, sub_zero] at h
  rw [Semigroups.StronglyContinuousGroup.ofBoundedExp_apply]
  simp only [Complex.coe_smul]
  simp only [expTime_def] at h
  refine h.trans (le_of_eq ?_)
  congr 1
  rw [show ((I : ℂ) • A.symmetricYosidaApproximation (n : ℝ)) ψ
        = (I : ℂ) • (A.symmetricYosidaApproximation (n : ℝ) ψ) from rfl,
    norm_smul, Complex.norm_I, one_mul]

/-- On the domain the limit flow is Lipschitz in `t`. -/
theorem norm_expLimit_sub_self_le (hA : IsSelfAdjoint A) (τ : ℝ)
    (ψ : H) (hψ : ψ ∈ A.domain) :
    ‖expLimit hA τ ψ - ψ‖ ≤ |τ| * ‖A ⟨ψ, hψ⟩‖ := by
  have hlim : Tendsto (fun n : ℕ+ => ‖ofBoundedExp (A.symmetricYosidaApproximation (n : ℝ)) τ ψ -
    ψ‖) atTop
      (𝓝 ‖expLimit hA τ ψ - ψ‖) :=
    ((tendsto_expLimitFun hA τ ψ).sub tendsto_const_nhds).norm
  have hbnd : Tendsto (fun n : ℕ+ => |τ| * ‖A.symmetricYosidaApproximation (n : ℝ) ψ‖) atTop
      (𝓝 (|τ| * ‖A ⟨ψ, hψ⟩‖)) :=
    ((((hA.tendsto_symmetricYosidaApproximation_apply ⟨ψ, hψ⟩).mono_left atTop_le_cocompact).comp
    (tendsto_natCast_atTop_atTop.comp tendsto_PNat_val_atTop_atTop)).norm).const_mul _
  exact le_of_tendsto_of_tendsto' hlim hbnd fun n => norm_yosidaFlow_sub_self_le hA n τ ψ

/-- The limit flow is continuous at every vector by uniform convergence on
bounded intervals of the strongly continuous approximating groups. -/
theorem continuous_expLimit (hA : IsSelfAdjoint A) (ψ : H) :
    Continuous (fun t : ℝ => expLimit hA t ψ) := by
  rw [continuous_iff_continuousAt]
  intro t
  let R := |t| + 1
  have h := uniformCauchySeqOn_yosidaFlow hA ψ (S := Set.Icc (-R) R)
    (fun _ hs => abs_le.mpr hs)
  have hlimit := h.tendstoUniformlyOn_of_tendsto fun s _ => tendsto_expLimitFun hA s ψ
  have hcontinuous (n : ℕ+) :
      ContinuousOn (fun s => ofBoundedExp (A.symmetricYosidaApproximation (n : ℝ)) s ψ)
        (Set.Icc (-R) R) :=
    ((ofBoundedExp (A.symmetricYosidaApproximation (n : ℝ))).continuous_orbit ψ).continuousOn
  have hcont := hlimit.continuousOn (Eventually.of_forall hcontinuous).frequently
  have hneighborhood : Set.Icc (-R) R ∈ 𝓝 t := Icc_mem_nhds
    (by dsimp [R]; linarith [neg_abs_le t]) (by dsimp [R]; linarith [le_abs_self t])
  exact hcont.continuousAt hneighborhood

/-- **Stone's theorem, the construction half.**  A self-adjoint operator
generates a one-parameter unitary group. -/
@[expose]
noncomputable def genToGroup (hA : IsSelfAdjoint A) :
    {G : Semigroups.StronglyContinuousGroup H // G.IsUnitary} where
  val :=
    { toFun := fun t => (expLimit hA t).restrictScalars ℝ
      map_zero' := by ext x; simp [expLimit_zero]
      map_add' s t := by
        ext x
        exact DFunLike.congr_fun (expLimit_add hA s t) x
      continuousAt_zero' x := (continuous_expLimit hA x).continuousAt }
  property := Semigroups.StronglyContinuousGroup.IsUnitary.intro (inner_expLimit hA)

end LinearPMap

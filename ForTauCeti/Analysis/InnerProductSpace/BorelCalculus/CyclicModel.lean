/-!
# The cyclic multiplication model of the spectral theorem

Layer 2 of the Hahn--Hellinger stack.  Layer 1
(`ForTauCeti/Analysis/InnerProductSpace/BorelCalculus/CyclicIsometry.lean`) proved the single
identity

```text
‖f(a) ξ‖² = ∫ ‖f x‖² d((cfcHom ha).representationDiagMeasure ξ)
```

and introduced the cyclic subspace generated by `ξ`.  This file turns that identity into a
map: `f ↦ f(a) ξ` is a **linear isometry of `L²((cfcHom ha).representationDiagMeasure ξ)` into `H`
whose range is
the cyclic subspace**, and the coordinate symbol acts through it as `a` itself.

The construction is the usual density/extension argument, assembled from three pieces.

1. Both linear maps take `BoundedBorelFunction (spectrum ℂ a)` as input.
   The images under `symbolCalculus ha ξ` in `H` and `symbolToLp ha ξ` in `L²`
   have the same norm (`norm_symbolCalculus`).
2. `denseRange_symbolToLp` says the second one has dense range.  This is where finiteness and
   regularity of `representationDiagMeasure` are used: on the compact spectrum, continuous symbols
   are
   already dense in `L²` of a finite regular measure, and a continuous symbol is bounded and
   measurable.
3. `LinearMap.extendOfNorm` then extends `symbolCalculus` along `symbolToLp`, and the isometry
   identity propagates to the extension by density.

## Main results

* `TauCeti.BorelCalculus.denseRange_symbolToLp`: bounded measurable symbols are dense in `L²`
  of the scalar spectral measure.
* `TauCeti.BorelCalculus.norm_symbolCalculus`: the isometry identity, in norm form.
* `TauCeti.BorelCalculus.cyclicIsometry`: the linear isometry `L²(μ_ξ) →ₗᵢ[ℂ] H`.
* `TauCeti.BorelCalculus.range_cyclicIsometry`: its range is `cyclicSubspace ha ξ`.
* `TauCeti.BorelCalculus.spectrumCoordinateLp`: the bounded coordinate class defining the
  native multiplication operator on `L²(μ_ξ)`.
* `TauCeti.BorelCalculus.cyclicIsometry_coordMulLp`: **the intertwining law** — the isometry
  carries multiplication by the coordinate to the action of `a`.

## What is not here

Nothing about *several* cyclic subspaces: the orthogonal decomposition of `H` into countably
many of them (layer 3), the ordering by measure class (layer 4) and the multiplicity function
(layer 5) are all still open.  See the modules named above for the layer
plan and the cost of each.

## Provenance

* Original repository: Davis--Kahan/DKPS formalization (Kitware, Inc.).
* Extraction class: **authored in place** for the Tau Ceti staging layer.
* Spectra influence: **none**.
-/

public section

open scoped InnerProductSpace ENNReal
open MeasureTheory

namespace TauCeti

namespace BorelCalculus

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable {a : H →L[ℂ] H}

section Symbols

/-- Evaluate the bounded Borel calculus at the cyclic vector. -/
noncomputable def symbolCalculus (ha : IsStarNormal a) (ξ : H) :
    BoundedBorelFunction (spectrum ℂ a) →ₗ[ℂ] H :=
  letI := ha
  (ContinuousLinearMap.apply ℂ H ξ).toLinearMap.comp a.borelCalculus.toLinearMap

/-- The symbol calculus is the native bounded Borel calculus evaluated at the vector. -/
@[simp] theorem symbolCalculus_apply (ha : IsStarNormal a) (ξ : H)
    (f : BoundedBorelFunction (spectrum ℂ a)) :
    haveI := ha
    symbolCalculus ha ξ f = a.borelCalculus f ξ := by rfl

/-- A bounded Borel symbol is square-integrable for the finite scalar spectral measure. -/
theorem memLp_two_symbol (ha : IsStarNormal a) (ξ : H)
    (f : BoundedBorelFunction (spectrum ℂ a)) :
    MemLp f 2 ((cfcHom ha).representationDiagMeasure ξ) :=
  MemLp.of_bound f.measurable.aestronglyMeasurable ‖f‖
    (Filter.Eventually.of_forall f.norm_coe_le_norm)

/-- **The symbol-to-`L²` map**: a bounded measurable symbol, viewed as an element of `L²` of
the scalar spectral measure of `ξ`. -/
noncomputable def symbolToLp (ha : IsStarNormal a) (ξ : H) :
    BoundedBorelFunction (spectrum ℂ a) →ₗ[ℂ] Lp ℂ 2 ((cfcHom ha).representationDiagMeasure ξ) where
  toFun f := MemLp.toLp (f : spectrum ℂ a → ℂ)
    (memLp_two_symbol ha ξ f)
  map_add' _ _ := MemLp.toLp_add _ _
  map_smul' c _ := MemLp.toLp_const_smul c _

/-- The symbol-to-`L²` map, unfolded. -/
theorem symbolToLp_apply (ha : IsStarNormal a) (ξ : H) (f : BoundedBorelFunction (spectrum ℂ a)) :
    symbolToLp ha ξ f = MemLp.toLp (f : spectrum ℂ a → ℂ)
      (memLp_two_symbol ha ξ f) := (rfl)

/-- The `L²` class of a bounded measurable symbol is represented by that symbol. -/
theorem coeFn_symbolToLp (ha : IsStarNormal a) (ξ : H) (f : BoundedBorelFunction (spectrum ℂ a)) :
    (symbolToLp ha ξ f : spectrum ℂ a → ℂ) =ᵐ[(cfcHom ha).representationDiagMeasure ξ] (f :
      spectrum ℂ a → ℂ) := by
  rw [symbolToLp_apply]
  exact MemLp.coeFn_toLp _

/-- The squared `L²` norm of a bounded measurable symbol. -/
theorem norm_symbolToLp_sq (ha : IsStarNormal a) (ξ : H) (f : BoundedBorelFunction (spectrum ℂ a)) :
    ‖symbolToLp ha ξ f‖ ^ 2 = ∫ x, ‖f x‖ ^ 2 ∂((cfcHom ha).representationDiagMeasure ξ) :=
  Lp.norm_sq_eq_integral_of_ae_eq (coeFn_symbolToLp ha ξ f)

/-- **The isometry identity, in norm form.**  On bounded measurable symbols, `f ↦ f(a) ξ` has
exactly the `L²(μ_ξ)` norm of the symbol.

The native squared-norm identity gives the bound used to extend the map in
`cyclicIsometry`. -/
theorem norm_symbolCalculus (ha : IsStarNormal a) (ξ : H)
    (f : BoundedBorelFunction (spectrum ℂ a)) :
    ‖symbolCalculus ha ξ f‖ = ‖symbolToLp ha ξ f‖ := by
  have hsq : ‖symbolCalculus ha ξ f‖ ^ 2 = ‖symbolToLp ha ξ f‖ ^ 2 := by
    have := ha
    rw [symbolCalculus_apply, norm_symbolToLp_sq]
    simpa only [← a.spectralPVM_diag, spectralPVM_diag_eq_representation ha] using
      a.norm_sq_borelCalculus_apply f ξ
  rw [← Real.sqrt_sq (norm_nonneg (symbolCalculus ha ξ f)),
    ← Real.sqrt_sq (norm_nonneg (symbolToLp ha ξ f)), hsq]

/-- The norm bound consumed by `LinearMap.extendOfNorm`: the constant is `1`, because the
symbol map is an isometry. -/
theorem exists_norm_symbolCalculus_le (ha : IsStarNormal a) (ξ : H) :
    ∃ C : ℝ, ∀ f : BoundedBorelFunction (spectrum ℂ a),
      ‖symbolCalculus ha ξ f‖ ≤ C * ‖symbolToLp ha ξ f‖ :=
  ⟨1, fun f => by rw [one_mul, norm_symbolCalculus]⟩

end Symbols

section Density

/-- **Bounded measurable symbols are dense in `L²` of the scalar spectral measure.**

The spectrum is compact and its diagonal measure is finite and regular.
The continuous symbols are dense by `ContinuousMap.toLp_denseRange` and give
bounded Borel symbols via `BoundedBorelFunction.ofContinuousMap`. -/
theorem denseRange_symbolToLp (ha : IsStarNormal a) (ξ : H) :
    DenseRange (symbolToLp ha ξ) := by
  refine (ContinuousMap.toLp_denseRange (α := spectrum ℂ a) ℂ ((cfcHom
    ha).representationDiagMeasure ξ)
    (p := 2) ℂ (by simp)).mono ?_
  rintro _ ⟨g, rfl⟩
  refine ⟨BoundedBorelFunction.ofContinuousMap g, ?_⟩
  rw [symbolToLp_apply,
    ← Lp.toLp_coeFn (ContinuousMap.toLp 2 ((cfcHom ha).representationDiagMeasure ξ) ℂ g) (Lp.memLp
      _)]
  apply (MemLp.toLp_eq_toLp_iff _ _).2
  filter_upwards [ContinuousMap.coeFn_toLp (𝕜 := ℂ) (p := 2)
    ((cfcHom ha).representationDiagMeasure ξ) g]
    with x hx
  rw [BoundedBorelFunction.ofContinuousMap_apply, hx]

end Density

section Isometry

/-- The extension of the symbol calculus along the symbol-to-`L²` map preserves norms.

Both sides are continuous in the `L²` variable and they agree on the dense range of
`symbolToLp` by `norm_symbolCalculus`, so they agree everywhere. -/
theorem norm_extendOfNorm_symbolCalculus (ha : IsStarNormal a) (ξ : H)
    (F : Lp ℂ 2 ((cfcHom ha).representationDiagMeasure ξ)) :
    ‖(symbolCalculus ha ξ).extendOfNorm (symbolToLp ha ξ) F‖ = ‖F‖ := by
  refine (denseRange_symbolToLp ha ξ).induction_on F
    (isClosed_eq (by fun_prop) continuous_norm) fun f => ?_
  rw [LinearMap.extendOfNorm_eq (denseRange_symbolToLp ha ξ)
    (exists_norm_symbolCalculus_le ha ξ) f]
  exact norm_symbolCalculus ha ξ f

/-- **The cyclic multiplication model, as an isometry.**  The map `f ↦ f(a) ξ` extends from
bounded measurable symbols to a linear isometry of `L²` of the scalar spectral measure of `ξ`
into the ambient Hilbert space.

Its range is the cyclic subspace generated by `ξ` (`range_cyclicIsometry`) and it carries
multiplication by the coordinate to `a` (`cyclicIsometry_coord_mul`); together those say that
`a` on the cyclic subspace *is* multiplication by the coordinate on `L²(μ_ξ)`. -/
noncomputable def cyclicIsometry (ha : IsStarNormal a) (ξ : H) :
    Lp ℂ 2 ((cfcHom ha).representationDiagMeasure ξ) →ₗᵢ[ℂ] H where
  toLinearMap := ((symbolCalculus ha ξ).extendOfNorm (symbolToLp ha ξ)).toLinearMap
  norm_map' := norm_extendOfNorm_symbolCalculus ha ξ

/-- **The defining property of the cyclic isometry**: on the class of a bounded measurable
symbol it is the Borel calculus at `ξ`. -/
theorem cyclicIsometry_symbolToLp (ha : IsStarNormal a) (ξ : H)
    (f : BoundedBorelFunction (spectrum ℂ a)) :
    haveI := ha
    cyclicIsometry ha ξ (symbolToLp ha ξ f) = a.borelCalculus f ξ :=
  LinearMap.extendOfNorm_eq (denseRange_symbolToLp ha ξ)
    (exists_norm_symbolCalculus_le ha ξ) f

/-- The range of the cyclic isometry is closed: the domain is complete and the map preserves
distances. -/
theorem isClosed_range_cyclicIsometry (ha : IsStarNormal a) (ξ : H) :
    IsClosed ((LinearMap.range (cyclicIsometry ha ξ).toLinearMap : Submodule ℂ H) : Set H) := by
  rw [LinearMap.coe_range]
  exact (cyclicIsometry ha ξ).isometry.isUniformInducing.isComplete_range.isClosed

/-- **The cyclic isometry lands in the cyclic subspace.**  Every `L²` class is a limit of
bounded measurable symbols, whose images lie in the (closed) cyclic subspace. -/
theorem cyclicIsometry_mem_cyclicSubspace (ha : IsStarNormal a) (ξ : H)
    (F : Lp ℂ 2 ((cfcHom ha).representationDiagMeasure ξ)) : cyclicIsometry ha ξ F ∈
      cyclicSubspace ha ξ := by
  refine (denseRange_symbolToLp ha ξ).induction_on F
    ((isClosed_cyclicSubspace ha ξ).preimage (cyclicIsometry ha ξ).continuous) fun f => ?_
  rw [cyclicIsometry_symbolToLp]
  have h := borelCalculus_apply_mem_cyclicSubspace ha (.ofBoundedBorelFunction f) ξ
  simpa only [borelCalculus_eq_native,
    IsBddMeasurable.toBoundedBorelFunction_ofBoundedBorelFunction] using h

/-- **The range of the cyclic isometry is the cyclic subspace.**

One inclusion is `cyclicIsometry_mem_cyclicSubspace`.  The other is minimality of the cyclic
subspace: the calculus orbit lies in the range, which is a closed submodule. -/
theorem range_cyclicIsometry (ha : IsStarNormal a) (ξ : H) :
    LinearMap.range (cyclicIsometry ha ξ).toLinearMap = cyclicSubspace ha ξ := by
  refine le_antisymm (fun y hy => ?_) ?_
  · obtain ⟨F, rfl⟩ := hy
    exact cyclicIsometry_mem_cyclicSubspace ha ξ F
  · refine cyclicSubspace_le ha (isClosed_range_cyclicIsometry ha ξ) fun f hf => ?_
    refine ⟨symbolToLp ha ξ hf.toBoundedBorelFunction, ?_⟩
    rw [borelCalculus_eq_native]
    exact cyclicIsometry_symbolToLp ha ξ hf.toBoundedBorelFunction

end Isometry

section Intertwining

/-- Multiplying a symbol by the coordinate applies the operator to the calculus at the vector. -/
theorem symbolCalculus_coord_mul (ha : IsStarNormal a) (ξ : H)
    (f : BoundedBorelFunction (spectrum ℂ a)) :
    symbolCalculus ha ξ
        (BoundedBorelFunction.ofContinuousMap ((ContinuousMap.id ℂ).restrict (spectrum ℂ a)) * f)
      = a (symbolCalculus ha ξ f) := by
  have := ha
  rw [symbolCalculus_apply, symbolCalculus_apply, map_mul, a.borelCalculus_restrict_id]
  rfl

/-- On symbols the cyclic isometry intertwines coordinate multiplication with the operator. -/
theorem cyclicIsometry_coord_mul (ha : IsStarNormal a) (ξ : H)
    (f : BoundedBorelFunction (spectrum ℂ a)) :
    cyclicIsometry ha ξ (symbolToLp ha ξ
        (BoundedBorelFunction.ofContinuousMap ((ContinuousMap.id ℂ).restrict (spectrum ℂ a)) * f))
      = a (cyclicIsometry ha ξ (symbolToLp ha ξ f)) := by
  rw [cyclicIsometry_symbolToLp, cyclicIsometry_symbolToLp]
  exact symbolCalculus_coord_mul ha ξ f

end Intertwining

section Multiplication

/-- The complex coordinate as an essentially bounded class of the scalar spectral measure. -/
noncomputable def spectrumCoordinateLp (ha : IsStarNormal a) (ξ : H) :
    Lp ℂ ∞ ((cfcHom ha).representationDiagMeasure ξ) :=
  let h := isBddMeasurable_coord (a := a)
  (memLp_top_of_bound h.measurable.aestronglyMeasurable h.chooseBound
    (Filter.Eventually.of_forall h.norm_le_chooseBound)).toLp (fun w : spectrum ℂ a => (w : ℂ))

/-- The spectral coordinate represents the pointwise inclusion almost everywhere. -/
theorem coeFn_spectrumCoordinateLp (ha : IsStarNormal a) (ξ : H) :
    (spectrumCoordinateLp ha ξ : spectrum ℂ a → ℂ) =ᵐ[(cfcHom ha).representationDiagMeasure ξ]
      fun w => (w : ℂ) := by
  unfold spectrumCoordinateLp
  exact MemLp.coeFn_toLp _

/-- The native multiplication operator for the spectral coordinate acts pointwise. -/
theorem coeFn_spectrumCoordinateLp_multiplicationOperator (ha : IsStarNormal a) (ξ : H)
    (F : Lp ℂ 2 ((cfcHom ha).representationDiagMeasure ξ)) :
    (Lp.multiplicationOperator (spectrumCoordinateLp ha ξ) F : spectrum ℂ a → ℂ)
      =ᵐ[(cfcHom ha).representationDiagMeasure ξ] fun w => (w : ℂ) * F w := by
  filter_upwards [Lp.multiplicationOperator_ae (spectrumCoordinateLp ha ξ) F,
    coeFn_spectrumCoordinateLp ha ξ] with w hm hw
  rw [hm, hw, smul_eq_mul]

/-- On the class of a bounded measurable symbol, coordinate multiplication is multiplication
of symbols. -/
theorem coordMulLp_symbolToLp (ha : IsStarNormal a) (ξ : H)
    (f : BoundedBorelFunction (spectrum ℂ a)) :
    Lp.multiplicationOperator (spectrumCoordinateLp ha ξ) (symbolToLp ha ξ f)
      = symbolToLp ha ξ (BoundedBorelFunction.ofContinuousMap
        ((ContinuousMap.id ℂ).restrict (spectrum ℂ a)) * f) := by
  refine Lp.ext ?_
  filter_upwards [coeFn_spectrumCoordinateLp_multiplicationOperator ha ξ (symbolToLp ha ξ f),
    coeFn_symbolToLp ha ξ f,
    coeFn_symbolToLp ha ξ
      (BoundedBorelFunction.ofContinuousMap ((ContinuousMap.id ℂ).restrict (spectrum ℂ a)) * f)]
    with w hmul hf hprod
  rw [hmul, hf, hprod, mul_apply, BoundedBorelFunction.ofContinuousMap_apply]
  rfl

/-- **The multiplication model.**  The cyclic isometry intertwines multiplication by the
coordinate on `L²(μ_ξ)` with the operator `a` on `H`:

```text
Φ (w · F) = a (Φ F)   for every F in L²(μ_ξ).
```

Both sides are continuous in `F` and agree on the dense set of bounded measurable symbols,
where the identity is `symbolCalculus_coord_mul`.  With `range_cyclicIsometry` this is the
statement that `a`, restricted to the cyclic subspace generated by `ξ`, *is* multiplication by
the coordinate on `L²` of the scalar spectral measure of `ξ`. -/
theorem cyclicIsometry_coordMulLp (ha : IsStarNormal a) (ξ : H)
    (F : Lp ℂ 2 ((cfcHom ha).representationDiagMeasure ξ)) :
    cyclicIsometry ha ξ (Lp.multiplicationOperator (spectrumCoordinateLp ha ξ) F)
      = a (cyclicIsometry ha ξ F) := by
  refine (denseRange_symbolToLp ha ξ).induction_on F
    (isClosed_eq ((cyclicIsometry ha ξ).continuous.comp
      (Lp.multiplicationOperator (spectrumCoordinateLp ha ξ)).continuous)
      (a.continuous.comp (cyclicIsometry ha ξ).continuous)) fun f => ?_
  rw [coordMulLp_symbolToLp]
  exact cyclicIsometry_coord_mul ha ξ f

/-- **The cyclic subspace is invariant under its operator.**  Immediate from the model: `a`
becomes multiplication by the coordinate, which does not leave `L²(μ_ξ)`. -/
theorem apply_mem_cyclicSubspace (ha : IsStarNormal a) (ξ : H) {y : H}
    (hy : y ∈ cyclicSubspace ha ξ) : a y ∈ cyclicSubspace ha ξ := by
  rw [← range_cyclicIsometry ha ξ] at hy ⊢
  obtain ⟨F, rfl⟩ := hy
  exact ⟨Lp.multiplicationOperator (spectrumCoordinateLp ha ξ) F,
    cyclicIsometry_coordMulLp ha ξ F⟩

end Multiplication

end BorelCalculus
end TauCeti

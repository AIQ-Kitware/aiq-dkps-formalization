# Lean / Lake build artifacts
# Both spellings on purpose: `.lake/` matches only a real directory, so it stops
# ignoring the cache the moment `.lake` is a symlink to a build dir on faster
# storage (see dev/README.md "Build cache on slow filesystems").
.lake/
.lake
build/
*.fdb_latexmk
*.fls
*.log
*.out
*.aux
*.synctex
*.pdf
*.tar.gz
__pycache__
*.pyc

# Agent worktrees. `.claude/settings.json` is tracked, so ignore the worktree
# subtree only. These hold a full second checkout: one subagent worktree put
# ~1259 extra `.lean` files inside the repo, which every gate that walks the
# repo root then scanned as if they were sources.
.claude/worktrees/

# Local reference clones of external Lean repos (not vendored; see dev/external-lean-references.md)
dev/reference-repos/
*.toc
*.tar.gz
*.gz

# leanq declaration indexes (regenerable)
.leanq/

# >>> llm_resource_tally local state (managed) >>>
/.llm_resource_tally/local/
# <<< llm_resource_tally local state (managed) <<<

# Local transcriptions / scans of the papers being formalized. These are
# copyrighted third-party sources kept for comparison only; `*.pdf` below
# already covers the scans, but the `.tex` transcriptions need their own rule.
# The census records them as `private_comparison_source`.
non-distributable/
git-of-theseus/
gitstats-report/


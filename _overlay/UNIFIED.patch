-    (U.isComplete_coe_of_hasOrthogonalProjection).completeSpace_coe
-  letI : CompleteSpace (Uᗮ : Submodule ℂ H) :=
-    (Uᗮ.isComplete_coe_of_hasOrthogonalProjection).completeSpace_coe

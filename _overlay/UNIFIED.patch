-theorem sinTheta_residual
-    {A : E →L[𝕜] E} (hA : IsSelfAdjointOperator A)
-    {U : Submodule 𝕜 E} [U.HasOrthogonalProjection]
-    (hU : Reduces A U)
-    {X : F →L[𝕜] E} (hX : IsometricEmbedding X)

-  Γ.geometric.path
-
-/-- The globally extended contour parameterization. -/
-noncomputable def param {A : H →L[ℂ] H} {s : Set ℝ}
-    (Γ : SpectralSeparatingContour A s) : ℝ → ℂ :=
-  Γ.geometric.param
-
-/-- The geometric contour image. -/

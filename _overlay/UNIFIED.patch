-    cfcL (a := A) hnormal
-  have hoperator :
-      IntervalIntegrable
-        (curveIntegralFun (resolventOneForm A) Γ.path) volume 0 1 :=
-    Γ.curveIntegrable_resolventOneForm
-  have hmapped :
-      IntervalIntegrable
-        (fun t => L (Γ.geometric.contourResolventSymbol A t))

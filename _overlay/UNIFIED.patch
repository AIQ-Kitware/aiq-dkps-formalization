-section Complex
-
-variable {E0c : Type*} [NormedAddCommGroup E0c] [InnerProductSpace ℂ E0c]
-  [CompleteSpace E0c]
-variable {E1c : Type*} [NormedAddCommGroup E1c] [InnerProductSpace ℂ E1c]
-  [CompleteSpace E1c]

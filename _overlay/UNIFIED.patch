-    {d : ℝ} (hd : 0 < d)
-    (hsep : OrderedSpectraSeparated M ⊤ A Uᗮ d) :
-    d * ‖sinThetaEmbedding U X‖ ≤ ‖residual A X M‖ := by
-  let Y : F →L[𝕜] Uᗮ :=
-    (complementaryProjection U ∘L X).corestrict Uᗮ
-  let C : F →L[𝕜] Uᗮ :=
-    (complementaryProjection U ∘L residual A X M).corestrict Uᗮ

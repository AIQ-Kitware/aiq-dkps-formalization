-  selfAdjoint : IsSelfAdjointOperator A
-  /-- Measurability required by the Borel spectral projection. -/
-  measurable_selected : MeasurableSet s
-  /-- Quantitative contour-to-spectrum margin. -/
-  spectralMargin : ℝ

-theorem subspaceCoordinate_conjugation_eq_blockOperator
-    (T : H →L[ℂ] H) (U : Submodule ℂ H) [U.HasOrthogonalProjection]
-    (hT : IsSelfAdjointOperator T) :
-    subspaceCoordinateAnalysis U ∘L T ∘L subspaceCoordinateSynthesis U =

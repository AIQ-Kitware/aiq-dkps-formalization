-        (μ := μ) (f := f) (g := fun g : C(spectrum ℂ A, ℂ) => L g)
-        hIso.lipschitz hIso.antilipschitz (by simp)
-    exact hiff.mp (by simpa only [Function.comp_def] using hf)

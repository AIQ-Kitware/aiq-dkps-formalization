# Python bytecode and caches
__pycache__/
*.py[cod]

# Disposable paper-analysis outputs and raw API responses.
generated/
build/

# Derived analysis tables. Keep the dated external observation JSON as data.
/snapshots/*.tex
/snapshots/*.csv

# Rendered figures are regenerated from the tracked Python sources.
/figures/*.pgf
/figures/*.svg
/figures/*.png
# These two SVG files are authored vector sources, rather than rendered outputs.
!/figures/complex_phase_chords.svg
!/figures/sine_theta_rank_one.svg

# LaTeX / latexmk build products.  Source .tex/.bib files remain tracked.
*.aux
*.bbl
*.bcf
*.blg
*.dvi
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.nav
*.out
*.ps
*.run.xml
*.snm
*.synctex.gz
*.toc
*.upa
*.upb
*.vrb
*.xdv
*.pdf

# Editor / OS noise
*~
.DS_Store

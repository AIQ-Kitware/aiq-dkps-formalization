# Copy to .env and set private server addresses there. Actual environment
# variables take precedence over .env. Never commit .env.
DKVIS_TTS_PROFILE=crall-math-dk-v2-breeze-tts2
# Optional Kokoro override: the full /v1/audio/speech URL.
# Falls back to localhost port 8880 if empty.
KOKORO_TTS_ENDPOINT=
# Optional overrides; empty values retain the localhost defaults in tts.toml.
CRALL_TTS_ENDPOINT=
BREEZE_TTS_ENDPOINT=
QWEN_TTS_ENDPOINT=
# Optional: local copy of the TTS server's reference files. Used only to record
# basenames, sizes, modification dates, and reference transcript text.
DKVIS_TTS_REFERENCE_DIR=

# Audio reader defaults to Kokoro independently of DKVIS_TTS_PROFILE.
# Set these only to override its default profile or endpoint.
# DKVIS_AUDIO_TTS_PROFILE=kokoro
# DKVIS_AUDIO_TTS_ENDPOINT=
# DKVIS_AUDIO_PAGE_CHARS=1200  # default; valid range: 250–1500

# Copy to .env and set private server addresses there. Actual environment
# variables take precedence over .env. Never commit .env.
DKVIS_TTS_PROFILE=crall-math-dk-v2-breeze-tts2
# Required for the Kokoro profile: the full /v1/audio/speech URL.
KOKORO_TTS_ENDPOINT=
# Optional overrides; empty values retain the localhost defaults in tts.toml.
CRALL_TTS_ENDPOINT=
BREEZE_TTS_ENDPOINT=
QWEN_TTS_ENDPOINT=
# Optional: local copy of the TTS server's reference files. Used only to record
# basenames, sizes, modification dates, and reference transcript text.
DKVIS_TTS_REFERENCE_DIR=

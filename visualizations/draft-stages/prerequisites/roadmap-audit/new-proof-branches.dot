digraph prerequisites {
  rankdir=LR;
  graph [fontname="DejaVu Sans", fontsize=12];
  node [fontname="DejaVu Sans", shape=box, style="rounded,filled", fillcolor="#edf2f7", color="#8999aa", fontsize=9];
  edge [arrowsize=0.6,color="#74849a"];
  "R-BAIRE" [label="Baire category and the three Banach mapping theorems",fillcolor="#e6f4ea"];
  "R-FINITE-RANK-GRAM" [label="Rank factorization and uniqueness of positive Gram factorizations",fillcolor="#e6f4ea"];
  "R-MOORE-PENROSE" [label="Moore–Penrose inverse and the four Penrose equations",fillcolor="#fff2de"];
  "R-SCHUR-HORN" [label="Doubly stochastic matrices, Birkhoff and Schur–Horn",fillcolor="#e6f4ea"];
  "R-KARAMATA-FAN" [label="Karamata and complete Fan-dominance argument",fillcolor="#e6f4ea"];
  "R-HOFFMAN-DAVIS" [label="Hoffman–Wielandt and Davis eigenvalue-change bounds",fillcolor="#e6f4ea"];
  "R-HS-HILBERT" [label="Hilbert–Schmidt operators as a Hilbert space and basis independence",fillcolor="#e6f4ea"];
  "R-FOURIER-LAPLACE" [label="Fourier transform, inverse transforms, Laplace integrals and Fubini",fillcolor="#e6f4ea"];
  "R-HZ-POISSON" [label="Poisson summation and odd-pole expansion for the reciprocal kernel",fillcolor="#e6f4ea"];
  "R-HZ-KERNEL" [label="Haagerup–Zsidó reciprocal kernel, transform identity and exact π/2 mass",fillcolor="#e6f4ea"];
  "R-BOCHNER" [label="Bochner integration of operator-valued functions and norm bounds",fillcolor="#e6f4ea"];
  "R-LAX-MILGRAM" [label="Coercive forms, Lax–Milgram and the ordered Sylvester inverse",fillcolor="#e6f4ea"];
  "R-ROSENBLUM-CONTOUR" [label="Complex contour calculus and Rosenblum uniqueness",fillcolor="#e6f4ea"];
  "R-KATO-RELLICH" [label="Relative boundedness and Kato–Rellich self-adjointness",fillcolor="#e6f4ea"];
  "R-CAYLEY-RESOLVENT" [label="Cayley transforms, resolvent identities and domain transfer",fillcolor="#e6f4ea"];
  "R-STRONG-APPROX" [label="Strong versus norm convergence and dominated spectral cutoff limits",fillcolor="#e6f4ea"];
  "R-BOREL-PVM-PROOF" [label="Scalar measure representation, PVM construction and Borel calculus proof",fillcolor="#e6f4ea"];
  "R-IDEAL-GAUGE-DOMAIN" [label="Symmetric gauges, finite/infinite approximation and ideal membership",fillcolor="#e6f4ea"];
  "R-UNBOUNDED-SYLVESTER" [label="Domain-aware Sylvester solution via resolvent and spectral cutoffs",fillcolor="#e6f4ea"];
  "R-MEASURABLE-PROJECTOR" [label="Measurability of random-matrix eigenvalues and threshold projectors",fillcolor="#eae5ff"];
  "R-MATRIX-CONCENTRATION" [label="Sample moments, matrix norm comparison and concentration",fillcolor="#eae5ff"];
  "R-STONE-GENERATOR" [label="Generator domain and Stone theorem through the spectral measure",fillcolor="#e6f4ea"];
  "R-TOEPLITZ-FOURIER" [label="Hardy spaces, Fourier series, Toeplitz and Hankel operators",fillcolor="#eae5ff"];
  "R-FREDHOLM-CALKIN" [label="Fredholm operators, compact quotients, C*-algebras, winding",fillcolor="#eae5ff"];
  "R-TOEPLITZ-FINITE-SECTIONS" [label="Finite-section method and stable Toeplitz approximation",fillcolor="#eae5ff"];
  "R-SCHUR-HORN" -> "R-KARAMATA-FAN";
  "R-SCHUR-HORN" -> "R-HOFFMAN-DAVIS";
  "R-FOURIER-LAPLACE" -> "R-HZ-POISSON";
  "R-FOURIER-LAPLACE" -> "R-HZ-KERNEL";
  "R-HZ-POISSON" -> "R-HZ-KERNEL";
  "R-BOCHNER" -> "R-UNBOUNDED-SYLVESTER";
  "R-CAYLEY-RESOLVENT" -> "R-UNBOUNDED-SYLVESTER";
  "R-BOREL-PVM-PROOF" -> "R-STONE-GENERATOR";
  "R-FOURIER-LAPLACE" -> "R-TOEPLITZ-FOURIER";
  "R-TOEPLITZ-FOURIER" -> "R-FREDHOLM-CALKIN";
  "R-TOEPLITZ-FOURIER" -> "R-TOEPLITZ-FINITE-SECTIONS";
  "R-FREDHOLM-CALKIN" -> "R-TOEPLITZ-FINITE-SECTIONS";
}

<?xml version="1.0" encoding="UTF-8"?>
<lexicon version="1.0"
         xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
         alphabet="ipa" xml:lang="en-US">
  <!-- User-reported improvements, not a guarantee across all speakers.
       Only spelling aliases are active in the text-only Breeze adapter.
       orthonormal -> ortho-normal remains tentative: it can introduce a pause.
       See README.md for the complete problem-word list and evidence. -->
  <lexeme>
    <grapheme>nonnegative</grapheme>
    <alias>non-negative</alias>
  </lexeme>
  <lexeme>
    <grapheme>eigenvectors</grapheme>
    <alias>eigen-vectors</alias>
  </lexeme>
</lexicon>

  {
   "id": "s4-prop4-3",
   "title": "Proposition 4.3 squared displacement (Ky Fan level)",
   "kind": "source",
   "module": "DavisKahan.Frontier.Section4",
   "declaration": "TauCeti.DavisKahan.Experimental.Frontier.Section4.proposition4_3_squaredDisplacement_kyFan",
   "dependencies": [
